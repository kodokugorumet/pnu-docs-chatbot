# Copy this file to .env and put your Gemini API key in GEMINI_API_KEY.
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey

RAG_GENERATION_MODE=auto
RAG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RAG_API_TOKEN=
RAG_MAX_TOP_K=20
RAG_MAX_REQUEST_BYTES=32768
RAG_MAX_QUESTION_CHARS=1000
RAG_PREVIEW_CHARS=700
RAG_SOURCE_CHARS=1800
RAG_MAX_CONCURRENT_GENERATIONS=2
RAG_DENSE_INDEX=processed/index/dense.sqlite
RAG_AUTO_PROVIDER_ORDER=gemini,extractive

# Optional OpenAI-compatible local model server.
# managed_mlx starts an owned MLX worker on the first local request. The UI can
# then terminate only that worker to release model memory, and the next local
# request starts it again.
RAG_LOCAL_RUNTIME=managed_mlx
RAG_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# Ollama or another separately managed endpoint must use external mode.
# RAG_LOCAL_RUNTIME=external
# RAG_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# RAG_LOCAL_MODEL is the default and remains the single-model compatibility setting.
RAG_LOCAL_MODEL=mlx-community/Qwen3.6-35B-A3B-4bit
# RAG_LOCAL_MODELS is the exact comma-separated allowlist exposed to API clients.
RAG_LOCAL_MODELS=mlx-community/EXAONE-4.0.1-32B-MLX-Q4,mlx-community/Qwen3.6-35B-A3B-4bit,mlx-community/gemma-4-26b-a4b-it-4bit
RAG_LOCAL_API_KEY=
RAG_LOCAL_API_STYLE=chat_completions
# Keep the provider timeout below the generation and browser deadlines so
# extractive fallback still has time to reach the UI when a local model stalls.
RAG_LOCAL_MAX_OUTPUT_TOKENS=450
# Qwen 계열의 추론 토큰만 출력되는 것을 막고 최종 답변을 바로 생성합니다.
RAG_LOCAL_CHAT_TEMPLATE_ARGS={"enable_thinking":false}
RAG_LOCAL_TIMEOUT_SECONDS=120
RAG_LOCAL_DEADLINE_SECONDS=150
RAG_LOCAL_STARTUP_TIMEOUT_SECONDS=15
RAG_LOCAL_TERMINATE_TIMEOUT_SECONDS=10

# Optional OpenAI-compatible hosted model. Keep the real key only in .env.
RAG_FRONTIER_BASE_URL=https://api.openai.com/v1
RAG_FRONTIER_MODEL=
RAG_FRONTIER_API_KEY=
RAG_FRONTIER_API_STYLE=responses
RAG_FRONTIER_TIMEOUT_SECONDS=30

GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=900
GEMINI_TIMEOUT_SECONDS=30

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_RAG_API_TOKEN=
VITE_MAX_QUESTION_CHARS=1000
VITE_CHAT_TIMEOUT_MS=240000
